# Copiar a .env y cambiar los valores. .env NO se versiona.

# Base de datos del producto (PostgreSQL propia)
NOVA_DB_USER=nova
NOVA_DB_PASSWORD=cambiar-esta-clave

# Base de metadatos de Airflow (separada de la del producto)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambiar-esta-otra-clave

# Usuario "admin" de la interfaz y API de Airflow (la API del producto lo usa para disparar el DAG)
AIRFLOW_ADMIN_PASSWORD=cambiar-clave-admin

# Secreto con el que los componentes de Airflow firman sus tokens (cualquier texto largo)
AIRFLOW_JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
